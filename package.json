{
  "name": "@wanrif/treez-federal",
  "version": "0.0.0",
  "description": "Micro frontend plugin for vite.",
  "homepage": "https://github.com/wanrif/treez-federal#readme",
  "bugs": {
    "url": "https://github.com/wanrif/treez-federal/issues"
  },
  "license": "MIT",
  "author": "Wanrif",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanrif/treez-federal.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format && bun run lint && bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
