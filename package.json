{
  "name": "treez-federal-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Treez Federal - Micro-Frontend Architecture with Vite, Rolldown and TanStack Router.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "exports": {
    ".": "./packages/treez-federal/dist/index.js",
    "./router": "./packages/treez-federal/dist/router.js",
    "./runtime": "./packages/treez-federal/dist/runtime.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run --cwd packages/treez-federal build",
    "build:pack": "bun run --cwd packages/treez-federal build:pack",
    "pack": "bun run --cwd packages/treez-federal pack",
    "dev": "bun run --cwd packages/treez-federal dev",
    "test": "vitest run tests",
    "coverage": "vitest run tests --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check": "bun run format && bun run lint && bun run test && bun run build",
    "example:dashboard": "bun run --cwd examples/dashboard-zone dev",
    "example:shell": "bun run --cwd examples/shell-host dev",
    "example:build": "bun run --cwd examples/dashboard-zone build && bun run --cwd examples/shell-host build"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitest/coverage-v8": "5.0.1",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "seroval": "^1.6.7",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
